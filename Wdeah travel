            const date = document.getElementById('booking-date').value || 'غير محدد';
            const notes = document.getElementById('user-notes').value || 'لا يوجد';

            let dynamicDetails = '';

            if (serviceType.includes('باص')) {
                const route = document.getElementById('route-select')?.value || '';
                const passengers = document.getElementById('passengers-count')?.value || '';
                dynamicDetails = `📍 الوجهة: ${route}\n👥 عدد المسافرين: ${passengers}`;
            } else if (serviceType.includes('سيارة')) {
                const car = document.getElementById('car-type')?.value || '';
                const route = document.getElementById('custom-route')?.value || '';
                dynamicDetails = `🚗 نوع السيارة: ${car}\n📍 المسار: ${route}`;
            } else if (serviceType.includes('تأشيرة')) {
                const visa = document.getElementById('visa-type')?.value || '';
                const count = document.getElementById('visa-persons')?.value || '1';
                dynamicDetails = `📋 نوع التأشيرة: ${visa}\n👥 عدد الأشخاص: ${count}`;
            } else if (serviceType.includes('شحن')) {
                const cargo = document.getElementById('cargo-type')?.value || '';
                const route = document.getElementById('cargo-route')?.value || '';
                dynamicDetails = `📦 نوع الشحنة: ${cargo}\n🚚 المسار: ${route}`;
            }

            const message = `السلام عليكم ورحمة الله وبركاته،\nأود تقديم طلب حجز عبر تطبيق الموقع:\n\n📌 نوع الخدمة: ${serviceType}\n👤 الاسم: ${name}\n📞 رقم الهاتف: ${phone}\n📅 التاريخ المتوقع: ${date}\n${dynamicDetails}\n📝 ملاحظات: ${notes}\n\nيرجى تزويدي بالتأكيد والأسعار المتاحة وشكراً.`;

            const encodedMessage = encodeURIComponent(message);
            const whatsappUrl = `https://wa.me/967779717173?text=${encodedMessage}`;

            window.open(whatsappUrl, '_blank');
        }

