                    btn.className = 'bg-white text-slate-700 hover:bg-slate-200 p-3 rounded-xl font-extrabold text-sm flex items-center justify-center gap-2 transition border border-transparent';
                }
            });

            document.getElementById('selected-service-type').value = titles[tabKey];
